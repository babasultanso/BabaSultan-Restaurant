rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isSignedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function getUserData() {
      return firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        ? firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data
        : {};
    }

    function getUserRole() {
      return getUserData().get('role', request.auth.token.get('role', ''));
    }

    function getUserBranch() {
      return getUserData().get('branchId', request.auth.token.get('branchId', ''));
    }

    function isHQ() {
      return isSignedIn() && (
        getUserRole() in ['Owner', 'owner'] ||
        getUserData().get('isOwner', false) == true ||
        request.auth.token.get('isOwner', false) == true ||
        (
          (getUserRole() in ['Admin', 'admin'] || getUserData().get('isAdmin', false) == true || request.auth.token.get('isAdmin', false) == true) &&
          (getUserData().get('isHQ', false) == true || request.auth.token.get('isHQ', false) == true)
        )
      );
    }

    function isManagement() {
      return isSignedIn() && (
        getUserRole() in ['Owner', 'owner', 'Admin', 'admin', 'Manager', 'manager'] ||
        getUserData().get('isAdmin', false) == true ||
        getUserData().get('isOwner', false) == true ||
        request.auth.token.get('isAdmin', false) == true ||
        request.auth.token.get('isOwner', false) == true
      );
    }

    function isManagementOrAccountant() {
      return isSignedIn() && (
        getUserRole() in ['Owner', 'owner', 'Admin', 'admin', 'Manager', 'manager', 'Accountant', 'accountant'] ||
        getUserData().get('isAdmin', false) == true ||
        getUserData().get('isOwner', false) == true ||
        request.auth.token.get('isAdmin', false) == true ||
        request.auth.token.get('isOwner', false) == true
      );
    }

    function isBranchAuthorized(branchId) {
      return isSignedIn() && (
        isHQ() ||
        getUserBranch() == branchId
      );
    }

    // Public Assets: Product and menu images (management only can upload)
    match /products/{imageId} {
      allow read: if isSignedIn();
      allow write: if isManagement() 
                   && request.resource.size < 5 * 1024 * 1024 
                   && request.resource.contentType.matches('image/(jpeg|png|webp|gif|svg\\+xml|jpg)');
    }

    // Branch-isolated storage paths
    match /branches/{branchId}/employee_documents/{docId} {
      allow read: if isBranchAuthorized(branchId) && (isManagement() || request.auth.uid == docId);
      allow write: if isBranchAuthorized(branchId) && (isManagement() || request.auth.uid == docId)
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('(image/.*|application/pdf|application/msword|application/vnd.openxmlformats-officedocument.wordprocessingml.document)');
    }

    match /branches/{branchId}/financial_attachments/{attachmentId} {
      allow read: if isBranchAuthorized(branchId) && isManagementOrAccountant();
      allow write: if isBranchAuthorized(branchId) && isManagementOrAccountant()
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('(image/.*|application/pdf|text/csv|application/vnd.ms-excel|application/vnd.openxmlformats-officedocument.spreadsheetml.sheet)');
    }

    match /branches/{branchId}/attachments/{attachmentId} {
      allow read: if isBranchAuthorized(branchId);
      allow write: if isBranchAuthorized(branchId) && isManagementOrAccountant()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('(image/.*|application/pdf|text/plain)');
    }

    // Protected employee and HRM documents (root path restricted to HQ or document owner)
    match /employee_documents/{docId} {
      allow read: if isSignedIn() && (isHQ() || request.auth.uid == docId);
      allow write: if isSignedIn() && (isHQ() || request.auth.uid == docId) 
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('(image/.*|application/pdf|application/msword|application/vnd.openxmlformats-officedocument.wordprocessingml.document)');
    }

    // Protected financial attachments & receipts (root path restricted to HQ)
    match /financial_attachments/{attachmentId} {
      allow read: if isHQ() && isManagementOrAccountant();
      allow write: if isHQ() && isManagementOrAccountant() 
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('(image/.*|application/pdf|text/csv|application/vnd.ms-excel|application/vnd.openxmlformats-officedocument.spreadsheetml.sheet)');
    }

    // General operational attachments
    match /attachments/{attachmentId} {
      allow read: if isHQ();
      allow write: if isHQ() && isManagementOrAccountant() 
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('(image/.*|application/pdf|text/plain)');
    }

    // Fallback: deny access to all unknown paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

